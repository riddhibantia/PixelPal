<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- OS-level backstop: cleartext permitted so self-hosted
         agents on private LAN / loopback can pair.
         All first-party traffic (Firebase, Gemini) is HTTPS regardless. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
