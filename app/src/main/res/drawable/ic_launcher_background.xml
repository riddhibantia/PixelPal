<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon launcher background — a rich indigo-to-deep-purple gradient
  realised as a solid colour + a soft radial shimmer layer, keeping the design
  system accent at #8B6CF6 (DarkPalette.Primary).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base indigo background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1035" />
        </shape>
    </item>
    <!-- Soft purple vignette for depth -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80%"
                android:startColor="#558B6CF6"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.4" />
        </shape>
    </item>
</layer-list>