rules_version = '2';

// PixelPal Firestore security rules.
//
// ONE branch: /users/{uid}. A signed-in user may read and write their own
// documents and nothing else. Everything else is denied by default.
//
// There used to be a second branch, /relays/{id}, which let a laptop bridge
// and the phone exchange agent state through Firestore when they were not on
// the same network. It was removed in favour of Tailscale: a private network
// between the user's own devices, with no third party in the data path, no
// per-user read quota (the relay cost 17,280 reads/day/user against a
// 50,000/day free tier), and nothing to deploy before pairing works.
//
// Deploy (only needed for cloud sync of tasks/reminders/companion):
//   firebase deploy --only firestore:rules
//
// Project: pixel-pet-a1cc6

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Existing user data — do not loosen.
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Companion is a single doc per user (users/{uid}/companion/primary)
      match /companion/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Tasks keyed by stable cloudId UUID — never auto-inc id
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /reminders/{remId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Bond & streak metrics (users/{uid}/metrics/bond) — synced by BondRepository.
      match /metrics/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Subtasks live top-level (users/{uid}/subtasks/{cloudId}), linked via parentCloudId.
      match /subtasks/{subId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Activity/personality are local-only; deny cloud writes if ever created
      match /{other=**} {
        allow read, write: if false;
      }
    }

    // Everything else: default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
